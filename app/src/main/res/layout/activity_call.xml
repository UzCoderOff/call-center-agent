<?xml version="1.0" encoding="utf-8"?>
<!-- The call screen (calling/CallActivity.kt): dark and calm, like a modern
     softphone.
       top       Ledger, "recording", the status or the time
       person    big with rippling rings while it rings or dials; a compact
                 row once connected, so what Ledger knows gets the room
       middle    what Ledger knows (cases, next step, who works on the
                 client — with "Ulash") or the keypad
       controls  mute, keypad, speaker / pass on, the client, consultation
       bottom    hang up (Decline / Answer while it rings)
     Over it all: the panel for passing the call on (calling/TransferPanel.kt). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call_screen"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo"
                android:tint="#CCFFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:text="Ledger"
                android:textColor="#CCFFFFFF"
                android:textSize="15sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/callRec"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_call_pill"
                android:backgroundTint="#33FF453A"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:visibility="gone">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_call_dot"
                    android:backgroundTint="#FF453A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/call_recording"
                    android:textColor="#FF8A82"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_call_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="12dp">

                <View
                    android:id="@+id/callStatusDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_call_dot" />

                <TextView
                    android:id="@+id/callStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- A call a colleague passed on, or one that came back. -->
        <LinearLayout
            android:id="@+id/callBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_call_pill"
            android:backgroundTint="#400A84FF"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_transfer"
                android:tint="#64D2FF" />

            <TextView
                android:id="@+id/callBannerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- The person, big: while it rings or dials. -->
        <LinearLayout
            android:id="@+id/callHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="180dp"
                android:layout_height="180dp">

                <View
                    android:id="@+id/callRing1"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/bg_call_ring" />

                <View
                    android:id="@+id/callRing2"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/bg_call_ring" />

                <TextView
                    android:id="@+id/callInitials"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_gravity="center"
                    android:elevation="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="40sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/callName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/callNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="0.03"
                android:textColor="#99FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/callKind"
                style="@style/CallKind"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- The person, compact: once connected. -->
        <LinearLayout
            android:id="@+id/callCompact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/callInitialsSmall"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="21sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/callNameSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/callNumberSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/callKindSmall"
                        style="@style/CallKind"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- The middle: what Ledger knows, or the keypad. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/callCardScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fadingEdgeLength="24dp"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/callDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center"
                        android:textColor="#B3FFFFFF"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/callCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_call_card"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/callWorkers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_call_card"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/callKeypad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/callDigits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFeatureSettings="tnum"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.08"
                    android:minHeight="44dp"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp" />

                <GridLayout
                    android:id="@+id/callKeys"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="3" />

                <TextView
                    android:id="@+id/callKeypadHide"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_call_chip"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/call_hide_keypad"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- While it rings: call back later instead. -->
        <LinearLayout
            android:id="@+id/callRemind"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="26dp"
            android:background="@drawable/bg_call_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_alarm" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/call_remind"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- While it goes on: two rows of round buttons. -->
        <GridLayout
            android:id="@+id/callOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:columnCount="3">

            <LinearLayout style="@style/CallOptionCell">

                <ImageButton
                    android:id="@+id/callMute"
                    style="@style/CallOptionButton"
                    android:contentDescription="@string/call_mute"
                    android:src="@drawable/ic_mic_off" />

                <TextView
                    style="@style/CallOptionLabel"
                    android:text="@string/call_mute" />
            </LinearLayout>

            <LinearLayout style="@style/CallOptionCell">

                <ImageButton
                    android:id="@+id/callKeypadToggle"
                    style="@style/CallOptionButton"
                    android:contentDescription="@string/call_keypad"
                    android:src="@drawable/ic_dialpad" />

                <TextView
                    style="@style/CallOptionLabel"
                    android:text="@string/call_keypad" />
            </LinearLayout>

            <LinearLayout style="@style/CallOptionCell">

                <ImageButton
                    android:id="@+id/callSpeaker"
                    style="@style/CallOptionButton"
                    android:contentDescription="@string/call_speaker"
                    android:src="@drawable/ic_volume_up" />

                <TextView
                    style="@style/CallOptionLabel"
                    android:text="@string/call_speaker" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/callTransferCell"
                style="@style/CallOptionCell">

                <ImageButton
                    android:id="@+id/callTransfer"
                    style="@style/CallOptionButton"
                    android:contentDescription="@string/call_transfer"
                    android:src="@drawable/ic_transfer" />

                <TextView
                    style="@style/CallOptionLabel"
                    android:text="@string/call_transfer" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/callClientCell"
                style="@style/CallOptionCell">

                <ImageButton
                    android:id="@+id/callClient"
                    style="@style/CallOptionButton"
                    android:contentDescription="@string/call_open_client"
                    android:src="@drawable/ic_person" />

                <TextView
                    android:id="@+id/callClientLabel"
                    style="@style/CallOptionLabel"
                    android:text="@string/call_open_client" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/callBookCell"
                style="@style/CallOptionCell">

                <ImageButton
                    android:id="@+id/callBook"
                    style="@style/CallOptionButton"
                    android:contentDescription="@string/call_book"
                    android:src="@drawable/ic_event" />

                <TextView
                    style="@style/CallOptionLabel"
                    android:text="@string/call_book" />
            </LinearLayout>
        </GridLayout>

        <!-- Hang up; Decline / Answer while it rings. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/callEndBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/callEnd"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_call_end"
                    android:contentDescription="@string/call_end"
                    android:elevation="8dp"
                    android:src="@drawable/ic_call_end" />

                <TextView
                    android:id="@+id/callEndLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/callAnswerBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/callAnswer"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_call_answer"
                    android:contentDescription="@string/call_answer"
                    android:elevation="8dp"
                    android:src="@drawable/ic_call" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/call_answer"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Passing the call on: a dimmed screen and a panel from the bottom. -->
    <View
        android:id="@+id/transferScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/transferSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_call_sheet"
        android:clickable="true"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_call_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/transfer_title"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/transfer_hint"
                    android:textColor="#99FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/transferClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_call_option"
                android:contentDescription="@string/transfer_cancel"
                android:scaleType="center"
                android:src="@drawable/ic_close"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_call_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                android:tint="#80FFFFFF" />

            <EditText
                android:id="@+id/transferSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/transfer_search"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textNoSuggestions"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textColorHint="#66FFFFFF"
                android:textCursorDrawable="@null"
                android:textSize="16sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/transferScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/transferList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="12dp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
