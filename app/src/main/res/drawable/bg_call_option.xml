<?xml version="1.0" encoding="utf-8"?>
<!-- The call screen's round buttons: frosted glass, white when switched on
     (mute, keypad, speaker). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40FFFFFF">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#1CFFFFFF" />
                    <stroke android:width="1dp" android:color="#14FFFFFF" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
