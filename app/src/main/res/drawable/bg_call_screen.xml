<?xml version="1.0" encoding="utf-8"?>
<!-- The call screen: deep navy into near black, with a soft glow behind the
     person (CallActivity). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:centerColor="#0F1628"
                android:endColor="#070A12"
                android:startColor="#1B2744"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:centerX="0.5"
                android:centerY="0.22"
                android:endColor="#000A84FF"
                android:gradientRadius="70%p"
                android:startColor="#330A84FF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
